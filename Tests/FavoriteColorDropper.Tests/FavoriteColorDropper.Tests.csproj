<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>FavoriteColorDropper.Tests</AssemblyName>
    <RootNamespace>FavoriteColorDropper.Tests</RootNamespace>
    <DefineConstants>$(DefineConstants);FCD_TEST_STUBS</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.7</RimWorldVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldVersion)' == '1.6'">
    <DefineConstants>$(DefineConstants);RIMWORLD_1_6_TEST</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldVersion)' == '1.7'">
    <DefineConstants>$(DefineConstants);RIMWORLD_1_7_TEST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../Source/FavoriteColorDropper/*.cs" Link="Production/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
